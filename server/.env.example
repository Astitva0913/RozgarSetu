# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kaamsetu

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay Credentials (Use Razorpay TEST MODE credentials for local development)
# 1. Sign up / log in to https://dashboard.razorpay.com/
# 2. Switch to TEST MODE (toggle at top navigation bar)
# 3. Navigate to Settings -> API Keys -> Generate Key
# 4. Paste your Test Key ID (starts with rzp_test_...) and Key Secret below:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Platform Commission Rate (0.10 = 10%)
COMMISSION_RATE=0.10

# Maximum Payment Limit per Job / Transaction in INR (10000 = ₹10,000)
PAYMENT_LIMIT=10000
